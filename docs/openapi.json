{
  "openapi": "3.1.0",
  "info": {
    "title": "Observable Instagram Orders",
    "description": "Order and inventory API. POST /api/orders supports Idempotency-Key and is rate limited.",
    "version": "2.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "summary": "List products",
        "operationId": "products_api_products_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ProductOut"
                  },
                  "type": "array",
                  "title": "Response Products Api Products Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a product",
        "operationId": "add_product_api_products_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductOut"
                }
              }
            }
          },
          "409": {
            "description": "Conflict with current state (e.g. insufficient stock, invalid status transition)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error (bad input or misused Idempotency-Key)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/products/{product_id}/stock": {
      "patch": {
        "summary": "Set physical stock",
        "operationId": "update_stock_api_products__product_id__stock_patch",
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Product Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StockUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductOut"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict with current state (e.g. insufficient stock, invalid status transition)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error (bad input or misused Idempotency-Key)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders": {
      "get": {
        "summary": "List orders",
        "operationId": "orders_api_orders_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderOut"
                  },
                  "title": "Response Orders Api Orders Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Place an order",
        "description": "Reserves stock and creates a PENDING order. Send an `Idempotency-Key` header (1-128 chars) to make retries safe: repeating the same key and body returns the original order (header `Idempotent-Replay: true`) without a second order or reservation. The same key with a different body returns 422. Limited per client IP; exceeding the limit returns 429 with `Retry-After`.",
        "operationId": "add_order_api_orders_post",
        "parameters": [
          {
            "name": "idempotency-key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Unique key per logical order attempt",
              "title": "Idempotency-Key"
            },
            "description": "Unique key per logical order attempt"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderOut"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict with current state (e.g. insufficient stock, invalid status transition)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error (bad input or misused Idempotency-Key)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded; see Retry-After header",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/orders/{order_id}/status": {
      "patch": {
        "summary": "Change order status",
        "description": "Repeat-safe: repeating a transition is rejected with 409 and changes no stock.",
        "operationId": "update_order_status_api_orders__order_id__status_patch",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Order Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderOut"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict with current state (e.g. insufficient stock, invalid status transition)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation error (bad input or misused Idempotency-Key)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "OrderCreate": {
        "properties": {
          "customer_reference": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Customer Reference"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItemCreate"
            },
            "type": "array",
            "minItems": 1,
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "customer_reference",
          "items"
        ],
        "title": "OrderCreate"
      },
      "OrderItemCreate": {
        "properties": {
          "product_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Product Id"
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "quantity"
        ],
        "title": "OrderItemCreate"
      },
      "OrderItemOut": {
        "properties": {
          "product_id": {
            "type": "integer",
            "title": "Product Id"
          },
          "product_name": {
            "type": "string",
            "title": "Product Name"
          },
          "variant": {
            "type": "string",
            "title": "Variant"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          },
          "unit_price": {
            "type": "number",
            "title": "Unit Price"
          }
        },
        "type": "object",
        "required": [
          "product_id",
          "product_name",
          "variant",
          "quantity",
          "unit_price"
        ],
        "title": "OrderItemOut"
      },
      "OrderOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "customer_reference": {
            "type": "string",
            "title": "Customer Reference"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "total": {
            "type": "number",
            "title": "Total"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItemOut"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "id",
          "customer_reference",
          "status",
          "total",
          "created_at",
          "items"
        ],
        "title": "OrderOut"
      },
      "OrderStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "PACKED",
          "SHIPPED",
          "COMPLETED",
          "CANCELLED"
        ],
        "title": "OrderStatus"
      },
      "ProductCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "variant": {
            "type": "string",
            "maxLength": 120,
            "title": "Variant",
            "default": ""
          },
          "price": {
            "type": "number",
            "minimum": 0.0,
            "title": "Price"
          },
          "stock_quantity": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Stock Quantity"
          }
        },
        "type": "object",
        "required": [
          "name",
          "price",
          "stock_quantity"
        ],
        "title": "ProductCreate"
      },
      "ProductOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "variant": {
            "type": "string",
            "title": "Variant"
          },
          "price": {
            "type": "number",
            "title": "Price"
          },
          "stock_quantity": {
            "type": "integer",
            "title": "Stock Quantity"
          },
          "reserved_quantity": {
            "type": "integer",
            "title": "Reserved Quantity"
          },
          "available_quantity": {
            "type": "integer",
            "title": "Available Quantity"
          },
          "sold_quantity": {
            "type": "integer",
            "title": "Sold Quantity"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "variant",
          "price",
          "stock_quantity",
          "reserved_quantity",
          "available_quantity",
          "sold_quantity"
        ],
        "title": "ProductOut"
      },
      "StatusUpdate": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "StatusUpdate"
      },
      "StockUpdate": {
        "properties": {
          "stock_quantity": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Stock Quantity"
          }
        },
        "type": "object",
        "required": [
          "stock_quantity"
        ],
        "title": "StockUpdate"
      }
    }
  }
}
